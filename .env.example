# Хостовые пути, монтируемые в контейнер (docker-compose.yml).
# Логин/пароль сюда НЕ добавлять — вводятся вручную в консоли при старте.
# См. wiki/16-docker-guide.md для подробных примеров разных сценариев.

# Конфигурация приложения (обязателен)
SETTINGS_FILE=./settings.json

# Исходные данные для миграции (обязателен)
EXCEL_FILE=./data/data.xlsx

# Папка/файл со сканами документов (опционально, зависит от documentsSheet в settings.json)
# Может быть:
#   - ./documents          локальная папка с PDF/JPG
#   - ./data/documents.xlsx отдельный Excel файл со сканами
#   - Z:/documents         сетевой маппированный диск (Windows)
#   - /mnt/share/docs      сетевая папка (Linux)
DOCUMENTS_FOLDER=./documents
