# Хостовые пути, монтируемые в контейнер (docker-compose.yml).
# Настрой под свой хост: cp .env.example .env
# Пути внутри контейнера (/data/...) менять не нужно — они же используются
# в settings.json и в Excel. Логин/пароль сюда НЕ добавлять —
# вводятся вручную в консоли при старте.
# См. wiki/16-docker-guide.md для подробных примеров разных сценариев.

# Файл настроек приложения (обязателен)
SETTINGS_FILE=./settings.json

# Исходный Excel: объекты и связи (обязателен)
EXCEL_FILE=./data/data.xlsx

# Отдельный Excel со сканами документов (опционален — только для documentsSheet
# с отдельным source; в settings.json указывается контейнерный путь /data/documents.xlsx)
DOCUMENTS_EXCEL=./data/documents.xlsx

# Папка с файлами сканов (опциональна; в Excel-колонке "Расположение файла"
# указываются контейнерные пути вида /data/documents/<имя файла>)
# Может быть:
#   - ./documents          локальная папка с PDF/JPG
#   - Z:/documents         сетевой маппированный диск (Windows)
#   - /mnt/share/docs      сетевая папка (Linux)
DOCUMENTS_FOLDER=./documents

# Куда писать логи приложения (logs/app.log, RollingFileAppender)
LOGS_DIR=./logs
